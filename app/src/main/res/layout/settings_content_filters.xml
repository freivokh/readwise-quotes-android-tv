<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Filter Type Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTER TYPE"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/filterSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/settings_spinner_background"
                android:popupBackground="@drawable/spinner_dropdown_background"
                android:dropDownVerticalOffset="8dp"
                android:dropDownHorizontalOffset="-8dp"
                android:dropDownWidth="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </LinearLayout>

        <!-- Tag Groups Card (visible when By Tag selected) -->
        <LinearLayout
            android:id="@+id/tagSelectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAG GROUPS"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/tagGroupsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/createGroupButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Create Group"
                android:textSize="12sp"
                android:textColor="@color/settings_text_primary"
                android:paddingHorizontal="16dp"
                android:background="@drawable/settings_focusable_item"
                android:focusable="true"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/selectedTagsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No groups enabled"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:fontStyle="italic"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
