<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sync Interval Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO SYNC"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sync_interval_label"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/syncIntervalSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/settings_spinner_background"
                android:popupBackground="@drawable/spinner_dropdown_background"
                android:dropDownVerticalOffset="8dp"
                android:dropDownHorizontalOffset="-8dp"
                android:dropDownWidth="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </LinearLayout>

        <!-- Sync Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/lastSyncedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last synced: Never"
                android:textColor="@color/settings_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/quoteCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 quotes"
                android:textColor="@color/settings_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
