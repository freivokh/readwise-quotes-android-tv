<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_card_surface" />
            <stroke android:width="2dp" android:color="@color/settings_focus_glow" />
            <corners android:radius="12dp" />
            <padding android:left="16dp" android:right="16dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_card_surface" />
            <stroke android:width="1dp" android:color="@color/settings_card_border" />
            <corners android:radius="12dp" />
            <padding android:left="16dp" android:right="16dp" />
        </shape>
    </item>
</selector>
